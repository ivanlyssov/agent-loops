# Copy to .env and fill in. Nothing here is required to run the tests or to compile
# the code — only to actually send notifications / talk to a real Telegram bot.

# --- cross-repo root (see common/config.py) ---
# Root directory this harness supervises: other repos' task backlogs (IDEAS.md-style
# files), a knowledge vault, a shared STATE.md. Leave unset if you're just trying the
# code out — only loop-supervisor, loop-synthesis, loop-nightly and loop-design-audit
# need it, and they fail loudly (not silently) if it's missing.
AGENT_LOOPS_HOME=

# --- P0 observability alerts (loop-status/notify.py) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- P1 human-approval queue bot (loop-queue/queue-bot.py) ---
# A SEPARATE bot from the one above: Telegram's getUpdates is exclusive per token,
# and the P0 alert bot may already be polled by something else.
QUEUE_BOT_TOKEN=
QUEUE_CHAT_ID=

# --- optional: text-to-speech for the nightly voice briefing ---
# Path to a script that takes (text, out_mp3_path) and writes an mp3. Voice briefing
# is best-effort and skipped entirely if this is unset.
TTS_SCRIPT=

# --- local models (all $0, all optional — every judge/grader here fails open) ---
OLLAMA_URL=http://localhost:11434/api/generate
